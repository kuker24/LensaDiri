{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "startup_timeout_sec": 60
    },
    "magicui": {
      "command": "npx",
      "args": ["-y", "@magicuidesign/mcp@latest"],
      "startup_timeout_sec": 60
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "<PATH_TO_PLAYWRIGHT_CHROME_OR_~/.local/bin/playwright-chrome>",
        "--headless"
      ],
      "startup_timeout_sec": 90
    },
    "filesystem-lensadiri": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "<ABSOLUTE_PATH_TO_LENSADIRI_REPOSITORY>"
      ],
      "disabled": true
    },
    "github-optional": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${MCP_GITHUB_TOKEN}"
      },
      "disabled": true
    },
    "postgres-development-readonly-optional": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${MCP_DEV_READONLY_DATABASE_URL}"],
      "disabled": true
    }
  }
}
